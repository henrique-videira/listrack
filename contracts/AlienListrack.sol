// SPDX-License-Identifier: MIT
// AlienListrack (AL): the contract deployed on the external ledger E.
// It records Alice's leg under the TxId derived on the regulated ledger R,
// groups recorded legs into time slots and exposes each closed slot's Merkle
// root and proofs through read-only functions.
//
// Revision (JFMI version of the paper, Section 4.3):
//  1. The external-leg deadline T_E is enforced HERE, on E. The deadline and the
//     hash-lock refund time T_A are computed on R and bound into TxId, so AL
//     enforces exactly the values R registered and needs no copy of R's parameters.
//  2. Slots are genesis-anchored: slot = (t - genesisTimestamp) / slotLength.
//     A slot is closed once the current slot is greater; roots and proofs are
//     served only for closed slots.
//  3. Merkle tree with domain separation and a committed leaf count (ListrackMerkle).
//  Fixes: each TxId can be recorded once; hash-lock claims and refunds use the
//  token of that trade and are mutually exclusive in time; native-coin legs work.

pragma solidity ^0.8.24;

import {ReentrancyGuard} from "./utils/ReentrancyGuard.sol";
import {ListrackMerkle} from "./ListrackMerkle.sol";
import "hardhat/console.sol";

interface IERC20 {
    function transferFrom(address from, address to, uint256 value) external returns (bool);
    function transfer(address to, uint256 value) external returns (bool);
    function allowance(address owner, address spender) external returns (uint256);
}

contract AlienListrack is ReentrancyGuard {

    // Alien leg transferred to Mike (plain mode) or claimed by Mike (hash-lock mode)
    event AlienSettled(bytes32 indexed _drexTxId, uint256 _alienBlock, uint256 _alienMerkleTxIndex);
    // Alien leg escrowed under the hashed secret (hash-lock mode)
    event AlienLocked(bytes32 indexed _drexTxId, uint256 _alienBlock, uint256 _alienMerkleTxIndex);
    // Alien leg returned to Alice (hash-lock mode, after T_A)
    event AlienRefunded(bytes32 indexed _drexTxId, address indexed _aliceAddress);

    struct TxStatus {
        uint256 slotNumber;       // [0] slot in which the leg was recorded
        uint256 txIndex;          // [1] leaf index inside that slot
        bool    isSettled;
        address aliceAddress;
        address mikeAddress;
        uint256 alienAmount;
        bytes32 hashedSecret;
        uint256 timeStampInserted;
        bool    isRefunded;       // true once no further transfer can happen
        address tokenContract;    // asset of this leg (address(0) = native coin)
        uint256 alienDeadline;    // T_E as a timestamp, bound into TxId
        uint256 alienRefundTime;  // T_A as a timestamp, bound into TxId
    }

    // slot number => TxIds recorded in that slot (the leaves of its Merkle tree)
    mapping (uint256 => bytes32[]) public chainConfirmedTx;

    // TxId => status of the alien leg
    mapping (bytes32 => TxStatus) public transactions;

    // slot length in seconds and the common genesis timestamp of the slot clock
    uint256 public immutable slotLength;
    uint256 public immutable genesisTimestamp;

    /// @param _slotLength        slot length in seconds
    /// @param _genesisTimestamp  start of slot 0; 0 = deployment time
    constructor(uint256 _slotLength, uint256 _genesisTimestamp) payable {
        require(_slotLength > 0, "Slot length must be positive");
        slotLength = _slotLength;
        genesisTimestamp = (_genesisTimestamp == 0) ? block.timestamp : _genesisTimestamp;
        require(genesisTimestamp <= block.timestamp, "Genesis in the future");
    }

    /// @notice Current slot of the genesis-anchored slot clock.
    function currentSlot() public view returns (uint256) {
        return (block.timestamp - genesisTimestamp) / slotLength;
    }

    /// @notice A slot is closed (its leaf set can no longer change) once the clock has moved past it.
    function isSlotClosed(uint256 _slotNumber) public view returns (bool) {
        return _slotNumber < currentSlot();
    }

    /// @notice Kept for compatibility with earlier scripts.
    function getLatestSlot() public view returns (uint256) {
        return currentSlot();
    }

    // Alice records her leg. The contract must have been approved by Alice to move
    // her tokens (ERC-20 approve), or the call must carry the native amount.
    function writeAlienLeg (
        // below are the inputs generated by the agreed transaction
        bytes32 _drexHashFields,
        address _aliceAlienAddress,
        address _mikeAlienAddress,
        address _alientokencontract, // alien contract to transfer tokens
        uint256 _alienAmount,
        bytes32 _hashedSecret,
        // below are the inputs generated by the Drex (regulated) chain
        bytes32 _drexPreviousId,
        uint256 _drexTxIndex,
        bytes32 _drexTxId,
        uint256 _alienDeadline,
        uint256 _alienRefundTime
    ) external payable nonReentrant
    {
        require(_alienAmount > 0, "Invalid Alien amount");
        require(_mikeAlienAddress != address(0), "No Mike Address");
        require(msg.sender == _aliceAlienAddress, "Only Alice can send this Transaction");

        // TxId re-derivation: the same chained hash computed by DrexListrack.setTrade
        bytes32 _fields = keccak256(abi.encodePacked(
            _drexHashFields, _aliceAlienAddress, _mikeAlienAddress, _alientokencontract, _alienAmount));
        bytes32 _position = keccak256(abi.encodePacked(
            _fields, _hashedSecret, _drexTxIndex, _alienDeadline, _alienRefundTime));
        require(keccak256(abi.encodePacked(_drexPreviousId, _position)) == _drexTxId,
            "Drex Id Hash is not equal to the inputed parameters");

        // each TxId can be recorded only once (no double use, no double escrow)
        require(transactions[_drexTxId].aliceAddress == address(0), "Transaction already recorded");

        // T_E enforced on E: a late leg is rejected before any asset moves
        require(block.timestamp <= _alienDeadline, "Alien leg deadline has passed");

        if (_alientokencontract == address(0)) {
            require(msg.value == _alienAmount, "Incorrect Alien amount sent");
        } else {
            require(msg.value == 0, "Native coin sent with a token leg");
        }

        bool success;
        if (_hashedSecret == bytes32(0)) {
            // plain mode: y goes straight to Mike
            if (_alientokencontract == address(0)) {
                (success,) = payable(_mikeAlienAddress).call{value: _alienAmount}("");
            } else {
                success = IERC20(_alientokencontract).transferFrom(msg.sender, _mikeAlienAddress, _alienAmount);
            }
        } else {
            // hash-lock mode: y is escrowed here under the hashed secret
            if (_alientokencontract == address(0)) {
                success = true; // msg.value is already held by this contract
            } else {
                success = IERC20(_alientokencontract).transferFrom(msg.sender, address(this), _alienAmount);
            }
        }
        require(success, "Alien transfer failed");

        uint256 _slot = currentSlot();
        chainConfirmedTx[_slot].push(_drexTxId);
        uint256 _index = chainConfirmedTx[_slot].length - 1;

        TxStatus storage t = transactions[_drexTxId];
        t.slotNumber        = _slot;
        t.txIndex           = _index;
        t.aliceAddress      = _aliceAlienAddress;
        t.mikeAddress       = _mikeAlienAddress;
        t.alienAmount       = _alienAmount;
        t.hashedSecret      = _hashedSecret;
        t.timeStampInserted = block.timestamp;
        t.tokenContract     = _alientokencontract;
        t.alienDeadline     = _alienDeadline;
        t.alienRefundTime   = _alienRefundTime;

        if (_hashedSecret == bytes32(0)) {
            t.isSettled  = true;
            t.isRefunded = true; // closed: nothing further can be transferred
            emit AlienSettled(_drexTxId, _slot, _index);
        } else {
            emit AlienLocked(_drexTxId, _slot, _index);
        }
    }

    // Hash-lock mode: Mike claims y with the secret Alice revealed on R.
    // Allowed only before T_A, so it can never race Alice's refund.
    function mikeSettleTrade(bytes32 _txId, bytes32 _secretRevealed) external nonReentrant {
        TxStatus storage t = transactions[_txId];
        require(t.hashedSecret != bytes32(0), "This is not a HTLC transaction");
        require(!t.isSettled, "Trade already settled");
        require(!t.isRefunded, "Funds already have been refunded");
        require(block.timestamp <= t.alienRefundTime, "Claim window has closed");
        require(keccak256(abi.encodePacked(_secretRevealed)) == t.hashedSecret,
            "Secret is not equal to Hashed Secret");

        t.isSettled = true;
        t.isRefunded = true;
        require(_pay(t.tokenContract, t.mikeAddress, t.alienAmount), "Transfer to Mike failed");
        emit AlienSettled(_txId, t.slotNumber, t.txIndex);
    }

    // Hash-lock mode: Alice reclaims y after T_A if Mike has not claimed it.
    function aliceGetRefund(bytes32 _txId) external nonReentrant {
        TxStatus storage t = transactions[_txId];
        require(t.hashedSecret != bytes32(0), "This is not a HTLC transaction eligible for refund");
        require(!t.isRefunded, "Funds already have been refunded");
        require(!t.isSettled, "Trade already settled");
        require(block.timestamp > t.alienRefundTime,
            "Refund is not yet available to Alice because expiration has not been achieved");

        t.isRefunded = true;
        require(_pay(t.tokenContract, t.aliceAddress, t.alienAmount), "Refund to Alice failed");
        emit AlienRefunded(_txId, t.aliceAddress);
    }

    function _pay(address _token, address _to, uint256 _amount) private returns (bool success) {
        if (_token == address(0)) {
            (success,) = payable(_to).call{value: _amount}("");
        } else {
            success = IERC20(_token).transfer(_to, _amount);
        }
    }

    /// @notice Number of leaves in a slot's tree (needed to verify a proof on R).
    function getSlotSize(uint256 _slotNumber) public view returns (uint256) {
        return chainConfirmedTx[_slotNumber].length;
    }

    /// @notice Read-only Merkle construction for a CLOSED slot.
    /// isProof = false → returns [committedRoot]
    /// isProof = true  → returns the sibling path of leaf `_proofIndex`
    /// For large slots, rebuild the tree off-chain from AlienSettled/AlienLocked events
    /// (the gas of this call grows linearly with the slot size; see Section 8.3).
    function createMerkleTree(uint256 _slotNumber, bool isProof, uint256 _proofIndex)
        public view returns (bytes32[] memory)
    {
        require(isSlotClosed(_slotNumber), "Slot is not closed yet");
        bytes32[] memory _data = chainConfirmedTx[_slotNumber];
        require(_data.length > 0, "No data to create Merkle tree");
        if (isProof) return ListrackMerkle.proof(_data, _proofIndex);
        bytes32[] memory _root = new bytes32[](1);
        _root[0] = ListrackMerkle.committedRoot(_data);
        return _root;
    }

    function getTradeFeatures(bytes32 _txId) public view returns (TxStatus memory) {
        return transactions[_txId];
    }
}
