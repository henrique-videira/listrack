# Copy this file to listrack.env (git-ignored) and fill in your own values.
# Never commit a real RPC URL, API key or private key.

# Regulated-ledger side (Sepolia in the proof of concept): use your own RPC URL,
# for example https://sepolia.infura.io/v3/<your-api-key>
DREX_RPC_URL=

# External-ledger side (optional; defaults to the public Moonbase Alpha endpoint)
# ALIEN_RPC_URL=https://rpc.api.moonbase.moonbeam.network

# Seven TEST-NETWORK private keys, comma-separated, in this order:
# owner, alice, bob, charlie, debbie, eva, mike
PRIVATE_KEYS=
